# Shared whitespace rules, so diffs only show real changes.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# gofmt decides Go formatting, and it uses tabs.
[{*.go,go.mod,go.sum}]
indent_style = tab
indent_size = unset

# Recipes in a Makefile must start with a tab.
[Makefile]
indent_style = tab
indent_size = unset

[*.py]
indent_size = 4
